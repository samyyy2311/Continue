<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later. The device keys stay on this phone: copied to another, they would
    let it pose as this one, and the sealed copies can't be opened without this phone's
    Keystore anyway. A restored or new phone gets new keys and pairs again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="secrets/" />
        <exclude domain="database" path="sealed-keys/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="secrets/" />
        <exclude domain="database" path="sealed-keys/" />
    </device-transfer>
</data-extraction-rules>
