<?xml version="1.0" encoding="utf-8"?>
<!-- Lets each paired computer show up as a direct target in the system share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="org.continueapp.android.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="org.continueapp.android.SEND_TO_COMPUTER" />
    </share-target>
</shortcuts>
