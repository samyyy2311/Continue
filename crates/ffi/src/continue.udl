namespace continue {
    // Where the device keys are kept, set before `init_core`. Without it they stay in files.
    void set_key_store(SecretStoreFfi store);

    [Throws=ContinueFfiError]
    void init_core(string db_path);

    [Throws=ContinueFfiError]
    void set_device_name(string name);

    [Throws=ContinueFfiError]
    void set_device_status(u32 battery_percent, boolean charging);

    [Throws=ContinueFfiError]
    string get_device_fingerprint();

    [Throws=ContinueFfiError]
    string get_device_spki_hash();

    [Throws=ContinueFfiError]
    void start_discovery(u32 protocol_version);

    [Throws=ContinueFfiError]
    void stop_discovery();

    [Throws=ContinueFfiError]
    TrustedPeerFfi pair_from_qr(string qr_payload);

    [Throws=ContinueFfiError]
    sequence<TrustedPeerFfi> list_trusted_peers();

    [Throws=ContinueFfiError]
    boolean remove_trusted_peer(string fingerprint);

    [Throws=ContinueFfiError]
    string query_permission(string peer_fingerprint, u32 capability_id);

    [Throws=ContinueFfiError]
    void set_permission(string peer_fingerprint, u32 capability_id, string grant);

    PermissionRequestFfi? next_permission_request(u32 timeout_ms);

    void answer_permission_request(u64 id, PermissionDecisionFfi decision);

    ReceivedFfi? next_received(u32 timeout_ms);

    sequence<IncomingFileFfi> list_incoming();

    boolean cancel_incoming(string transfer_id);

    [Throws=ContinueFfiError]
    sequence<HistoryEntryFfi> list_history(u32 limit);

    [Throws=ContinueFfiError]
    void clear_history();

    [Throws=ContinueFfiError]
    void set_history_location(i64 id, string location);

    [Throws=ContinueFfiError]
    void connect_to_peer(string peer_fingerprint, string endpoint);

    [Throws=ContinueFfiError]
    boolean is_peer_connected(string peer_fingerprint);

    [Throws=ContinueFfiError]
    void disconnect(string peer_fingerprint);

    [Throws=ContinueFfiError]
    void reconnect(string peer_fingerprint);

    [Throws=ContinueFfiError]
    u64 send_file(string peer_fingerprint, string file_path);

    [Throws=ContinueFfiError]
    void send_clipboard_text(string peer_fingerprint, string text);
};

dictionary PermissionRequestFfi {
    u64 id;
    string peer_fingerprint;
    string peer_name;
    u32 capability_id;
    string? detail;
    u64 expires_at;
};

enum PermissionDecisionFfi {
    "Allow",
    "AlwaysAllow",
    "Decline",
};

dictionary IncomingFileFfi {
    string transfer_id;
    string peer_name;
    string file_name;
    u64 received;
    u64 total;
};

dictionary ReceivedFfi {
    i64? history_id;
    string peer_fingerprint;
    string peer_name;
    string? file_path;
    string? file_name;
    u64 size;
    string? text;
};

dictionary HistoryEntryFfi {
    i64 id;
    u64 at;
    boolean received;
    boolean is_text;
    string label;
    string peer_fingerprint;
    string peer_name;
    u64 size;
    boolean failed;
    string? location;
};

dictionary TrustedPeerFfi {
    string fingerprint;
    string display_name;
    u64 paired_at;
};

// The platform's secret store, implemented by the app (the Android Keystore).
callback interface SecretStoreFfi {
    [Throws=SecretStoreFfiError]
    void store(string label, bytes secret);

    [Throws=SecretStoreFfiError]
    bytes? load(string label);

    [Throws=SecretStoreFfiError]
    void delete(string label);
};

[Error]
interface SecretStoreFfiError {
    Unavailable(string reason);
};

[Error]
enum ContinueFfiError {
    "InternalError",
    "InvalidQr",
    "PairingFailed",
    "DatabaseError",
    "NotInitialized",
};
